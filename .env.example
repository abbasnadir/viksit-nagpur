# Environment Variables Example for Nagpur Traffic AI

# --- General ---
PROJECT_NAME="Nagpur Traffic AI"
ENVIRONMENT=development
DEBUG=True

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Map & GIS ---
NAGPUR_CENTER_LAT=21.1458
NAGPUR_CENTER_LNG=79.0882
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# --- ML & Simulation ---
MODEL_PATH=./ml/models/traffic_predictor_latest.pkl
SIMULATION_INTERVAL_SEC=2
SIMULATION_SPEED_MULTIPLIER=1.0

# --- Database / Cache (Optional) ---
DATABASE_URL=sqlite:///./traffic_data.db
REDIS_URL=redis://localhost:6379/0
